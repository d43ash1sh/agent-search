FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn redis pydantic opensearch-py

COPY services/common /app/services/common
COPY services/queue /app/services/queue
COPY services/indexer /app/services/indexer
COPY services/api /app/services/api
COPY crawler /app/crawler

ENV PYTHONPATH=/app

CMD ["uvicorn", "services.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
